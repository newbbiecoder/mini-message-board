<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/styles.css">
    </head>
    <body>
        <ul>
            <% users.forEach((user) => { %>
                <li>User: <%= user.username %></li>
                <li>Message: <%= user.text %></li>
                <li>Date: <%= user.added %></li>
                <li>Id: <%= user.id %></li>
                <button onclick="window.location.href='/authors/<%= user.id %>'">Open the message</button>
            <% })  %>
        </ul>
        <button onclick="window.location.href='/new';">Submit A Form</button>
    </body>
</html>